# --- Server ---
PORT=5001
NODE_ENV=development

# Return OTP in auth API JSON when SMS is not wired yet (staging/testing). Omit on live production.
# EXPOSE_OTP_IN_RESPONSE=true

# Full URL for uploads in mobile API responses (optional; defaults to http://localhost:PORT)
# PUBLIC_BASE_URL=http://localhost:5000

# --- Database ---
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/ohoecom

# Fallback cart shipping charge when App Config has no value (default: 40)
# CART_SHIPPING_CHARGE=40

# FCM_SERVER_KEY=your_firebase_legacy_server_key

# --- JWT: access tokens (login / register — used now) ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=365d

# --- JWT: optional separate keys (defaults to JWT_SECRET if unset) ---
# Used when you add refresh tokens, signed reset links, or email verification.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=365d
JWT_RESET_PASSWORD_SECRET=
JWT_RESET_PASSWORD_EXPIRES_IN=1h
JWT_VERIFY_EMAIL_SECRET=
JWT_VERIFY_EMAIL_EXPIRES_IN=24h
