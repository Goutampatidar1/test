# Copy to .env on the production server and fill in real values.
# chmod 600 .env

PORT=5001
NODE_ENV=production

# MongoDB (required in production)
# Database name must match where you ran seed (ohoebazaar or ohoecom)
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/ohoebazaar?authSource=admin

# JWT (required in production — use a long random secret)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARACTERS
JWT_EXPIRES_IN=8h

# Public URL for uploaded images in API responses (required)
PUBLIC_BASE_URL=https://ohoecom.developmentalphawizz.com

# Do NOT enable on live production (OTP must be sent via SMS only)
# EXPOSE_OTP_IN_RESPONSE=false

# Optional
# CART_SHIPPING_CHARGE=40
# FCM_SERVER_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
